@model IEnumerable<BeachSAWeb.Models.Reservation>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    int totalReservations = ViewBag.TotalReservations ?? 128;
    decimal totalSalesUsd = ViewBag.TotalSalesUsd ?? 0m;
    int totalClients = ViewBag.TotalClients ?? 342;
    var recentReservations = Model?.ToList() ?? new List<BeachSAWeb.Models.Reservation>();
}

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="beach-kpi-label">Reservaciones</div>
        <div class="beach-kpi-value">@totalReservations</div>
    </div>
    <div class="col-md-4">
        <div class="beach-kpi-label">Ventas (USD)</div>
        <div class="beach-kpi-value">$ @totalSalesUsd.ToString("N0")</div>
    </div>
    <div class="col-md-4">
        <div class="beach-kpi-label">Clientes</div>
        <div class="beach-kpi-value">@totalClients</div>
    </div>
</div>

<h2 class="h5 fw-bold text-dark mb-3">Últimas reservaciones</h2>

<div class="table-responsive">
    <table class="table beach-admin-table">
        <thead>
            <tr>
                <th>N°</th>
                <th>Cliente</th>
                <th>Paquete</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @if (!recentReservations.Any())
            {
                <tr>
                    <td>R-0003</td>
                    <td>Nombre Apellido</td>
                    <td>Todo incluido</td>
                    <td>$4,576.50</td>
                </tr>
                <tr>
                    <td>R-0002</td>
                    <td>Nombre Apellido</td>
                    <td>Hospedaje</td>
                    <td>$1,281.42</td>
                </tr>
                <tr>
                    <td>R-0001</td>
                    <td>Nombre Apellido</td>
                    <td>Alimentación</td>
                    <td>$2,113.10</td>
                </tr>
            }
            else
            {
                @foreach (var item in recentReservations)
                {
                    <tr>
                        <td>R-@item.Id.ToString("D4")</td>
                        <td>@(item.User?.FullName ?? $"Cliente #{item.UserId}")</td>
                        @* <td>@(item.Package?.Name ?? $"Paquete #{item.PackageId}")</td>
                        <td>$@((item.Invoice?.TotalUsd ?? 0m).ToString("N2"))</td> *@
                    </tr>
                }
            }
        </tbody>
    </table>
</div>