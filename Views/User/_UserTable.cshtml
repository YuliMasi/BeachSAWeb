@model List<BeachSAWeb.Models.User>

@{
    string current = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="table-responsive">
    <table class="table beach-admin-table">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">No hay usuarios registrados.</td></tr>
            }
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FullName</td>
                    <td>@user.IdType</td>
                    <td>@user.Email</td>
                    <td>@(user.PhoneNumber > 0 ? user.PhoneNumber.ToString() : "")</td>
                    <td>@(user.Role == "Admin" ? "Administrador" : "Cliente")</td>
                    <td class="text-nowrap">
                        <a href="#" class="beach-link-action" data-bs-toggle="modal" data-bs-target="#editUserModal"
                           data-email="@user.Email" data-name="@user.FullName" data-phone="@(user.PhoneNumber > 0 ? user.PhoneNumber.ToString() : "")"
                           data-address="@user.Address" data-role="@user.Role"
                           onclick="openEditUserModal(this)">Editar</a>
                        @if (user.Role != "Admin")
                        {
                            <span class="mx-1 text-muted">·</span>
                            <form asp-controller="User" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar a @user.FullName?');">
                                <input type="hidden" name="email" value="@user.Email" />
                                <input type="hidden" name="returnAction" value="@current" />
                                <button type="submit" class="btn btn-link p-0 beach-link-action align-baseline">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_EditUserModal")
