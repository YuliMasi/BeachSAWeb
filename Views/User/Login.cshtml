@model BeachSAWeb.Models.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Login</h1>
<div class="container">
    <div class="row">
        <div class="col-md-4">
        </div>

        <div class="col-md-4">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form id="FormLogin" asp-controller="User" asp-action="Login">
                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        Email
                    </label>
                    <input asp-for="Email" class="form-control" placeholder="email@domain.com" />
                    <span asp-validation-for="Email" class="text-bg-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-bg-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Aceptar" class="btn btn-outline-primary btn-sm" />
                </div>

            </form>

        </div>

        <div class="col-md-4">
        </div>
    </div>
</div>
