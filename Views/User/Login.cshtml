@model BeachSAWeb.Models.User

@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["CarouselTitle"] = "Esperando un día soleado y tranquilo";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-form">
    <img src="~/img/logo-blue.png" alt="Beach.SA" class="auth-logo" />

    <h1 class="auth-title">Iniciar sesión</h1>
    <p class="auth-subtitle">Deja tus huellas en la arena</p>
    <p class="auth-text">Gracias por volver a Beach.SA. Ingresa para ver tus reservaciones y las mejores ofertas para ti.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form id="FormLogin" asp-controller="User" asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="mb-3">
            <label asp-for="Email" class="label-beach">Correo electrónico</label>
            <input asp-for="Email" class="form-control input-beach" placeholder="usuario@correo.com" required />
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="label-beach">Contraseña</label>
            <input asp-for="Password" class="form-control input-beach" placeholder="••••••••" required />
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="remember" name="remember" value="true" />
                <label class="form-check-label label-beach" for="remember">Recordarme</label>
            </div>
            <a href="#" class="link-beach link-small-beach">¿Olvidó su contraseña?</a>
        </div>

        <button type="submit" class="btn-beach">Ingresar</button>
    </form>

    <p class="auth-switch">
        ¿No tiene cuenta? <a asp-controller="User" asp-action="Register" class="link-beach">Regístrese</a>
    </p>
</div>

<partial name="_AuthCarousel" />
