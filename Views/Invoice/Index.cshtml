@using BeachSAWeb.Services
@model List<BeachSAWeb.Models.Invoice>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Facturación";
}

@section TopActions {
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="number" name="value" value="@ViewData["value"]" min="1" class="form-control beach-pill-input" placeholder="N° de factura" />
        <button type="submit" class="btn beach-btn-outline-navy">Buscar</button>
    </form>
}

<div class="table-responsive">
    <table class="table beach-admin-table">
        <thead>
            <tr>
                <th>N°</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Paquete</th>
                <th>Total USD</th>
                <th>Total CRC</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">No hay facturas registradas.</td></tr>
            }
            @foreach (var inv in Model)
            {
                string client = inv.User?.FullName ?? $"Cliente #{inv.UserId}";
                string pkg = PackageInfo.Name(inv.Package?.PackageType ?? $"Paquete #{inv.PackageId}");
                <tr>
                    <td>@inv.InvoiceNumber.ToString("D6")</td>
                    <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@client</td>
                    <td>@pkg</td>
                    <td>$@inv.TotalUsd.ToString("N2")</td>
                    <td>₡@inv.TotalColones.ToString("N2")</td>
                    <td class="text-nowrap">
                        <a href="#" class="beach-link-action" data-bs-toggle="modal" data-bs-target="#viewInvoiceModal"
                           data-number="@inv.InvoiceNumber.ToString("D6")"
                           data-date="@inv.InvoiceDate.ToString("dd/MM/yyyy")"
                           data-client="@client"
                           data-package="@pkg"
                           data-nights="@(inv.Reservation?.AccommodationDays ?? 0)"
                           data-payment="@ReservationInfo.PaymentName(inv.Reservation?.PaymentMethod)"
                           data-discount-label="Descuento @((inv.Discount * 100).ToString("N0"))%"
                           data-discount="-$@inv.DiscountAmount.ToString("N2")"
                           data-iva="$@inv.IvaAmount.ToString("N2")"
                           data-total-usd="$@inv.TotalUsd.ToString("N2")"
                           data-total-crc="₡@inv.TotalColones.ToString("N2")"
                           data-reservation="@inv.ReservationId"
                           onclick="openInvoiceModal(this)">Ver</a>
                        <span class="mx-1 text-muted">·</span>
                        <a asp-action="Pdf" asp-route-reservationId="@inv.ReservationId" class="beach-link-action">PDF</a>
                        <span class="mx-1 text-muted">·</span>
                        <form asp-action="SendEmail" method="post" class="d-inline">
                            <input type="hidden" name="reservationId" value="@inv.ReservationId" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Invoice")" />
                            <button type="submit" class="btn btn-link p-0 beach-link-action align-baseline">Reenviar PDF</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_ViewInvoiceModal")

@section Scripts {
    <script>
        function openInvoiceModal(link) {
            const d = link.dataset;
            document.getElementById("invNumber").textContent = "Factura N° " + d.number;
            document.getElementById("invDate").textContent = d.date;
            document.getElementById("invClient").textContent = d.client;
            document.getElementById("invPackage").textContent = d.package;
            document.getElementById("invNights").textContent = d.nights;
            document.getElementById("invPayment").textContent = d.payment;
            document.getElementById("invDiscountLabel").textContent = d.discountLabel;
            document.getElementById("invDiscount").textContent = d.discount;
            document.getElementById("invIva").textContent = d.iva;
            document.getElementById("invTotalUsd").textContent = d.totalUsd;
            document.getElementById("invTotalCrc").textContent = d.totalCrc;
            document.getElementById("invPdfLink").href = "@Url.Action("Pdf", "Invoice")?reservationId=" + d.reservation;
            document.getElementById("invReservationId").value = d.reservation;
        }
    </script>
}
