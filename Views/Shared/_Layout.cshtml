<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeachSAWeb</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/designSystem.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeachSAWeb.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-beach">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.png" alt="Beach.SA" height="40" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    @{
                        // Controlador y acción actuales para marcar la opción activa del menú
                        string ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        string act = ViewContext.RouteData.Values["action"]?.ToString();
                    }

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link nav-link-beach @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-beach @(ctrl == "Package" ? "active" : "")" asp-controller="Package" asp-action="Index">Paquetes</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-beach @(ctrl == "Reservation" && act == "Create" ? "active" : "")" asp-controller="Reservation" asp-action="Create">Reservar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-beach @(ctrl == "Reservation" && act == "Index" ? "active" : "")" asp-controller="Reservation" asp-action="Index">Mis reservaciones</a>
                            </li>

                            @* Perfil: datos del usuario guardados al iniciar sesión *@
                            string fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                            string phone = User.FindFirst("Phone")?.Value;
                            string role = User.IsInRole("Admin") ? "Administrador" : "Cliente";
                            string initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));

                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-beach d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <span class="avatar-beach">@initials</span>
                                    <strong>Perfil</strong>
                                </a>

                                <div class="dropdown-menu dropdown-menu-end profile-card">
                                    <span class="avatar-beach avatar-beach-lg">@initials</span>

                                    <h2 class="profile-name">@fullName</h2>
                                    <p class="profile-email">@User.Identity.Name</p>

                                    <ul class="profile-details">
                                        @if (!string.IsNullOrEmpty(phone))
                                        {
                                            <li>Tel. · @phone</li>
                                        }
                                        <li>@role</li>
                                    </ul>

                                    <a asp-controller="User" asp-action="Logout" class="btn-beach">Salir</a>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn-outline-beach" asp-controller="User" asp-action="Login">Ingresar</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    @* Sección opcional a todo el ancho (hero del Home) *@
    @await RenderSectionAsync("Hero", required: false)

    <div class="container flex-grow-1">
        <main role="main" class="pt-3 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-beach mt-auto">
        <div class="container py-5">
            <div class="row">

                <!-- Logo y descripción -->
                <div class="col-md-6 mb-4">
                    <img src="~/img/logo.png" alt="Beach.SA" height="50" class="mb-3" />
                    <p class="footer-text">
                        Vive tu paraíso frente al mar.<br />
                        Reserva tu paquete en línea.
                    </p>
                </div>

                <!-- Navegación -->
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Navegación</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="footer-link">Inicio</a></li>
                        <li class="mb-2"><a asp-controller="Package" asp-action="Index" class="footer-link">Paquetes</a></li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="mb-2"><a asp-controller="Reservation" asp-action="Index" class="footer-link">Mis reservaciones</a></li>
                        }
                        else
                        {
                            <li class="mb-2"><a asp-controller="User" asp-action="Login" class="footer-link">Iniciar sesión</a></li>
                        }
                    </ul>
                </div>

                <!-- Contacto -->
                <div class="col-md-3 mb-4 d-md-flex justify-content-md-end">
                    <div>
                        <h6 class="footer-title">Contacto</h6>
                        <p class="footer-text mb-2">info@beachsa.com</p>
                        <p class="footer-text mb-2">+506 0000 0000</p>
                    </div>
                </div>

            </div>

            <hr class="footer-line" />

            <p class="footer-copy mb-0">
                &copy; 2026 Beach.SA · Hoteles &amp; Resort. Todos los derechos reservados.
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>