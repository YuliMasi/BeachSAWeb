@model BeachSAWeb.Models.Reservation

@{
    ViewData["Title"] = "Nueva reservación";
}

<div class="container py-4 py-md-5">
    <h1 class="beach-title h2 mb-4">Nueva reservación</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="Create" method="post" id="reservationForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* Campos internos que se calculan o asignan en el servidor *@
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="AccommodationDays" id="AccommodationDays" />
        <input type="hidden" asp-for="Discount" id="Discount" />
        <input type="hidden" asp-for="IVA" id="IVA" />

        <div class="row g-4 align-items-start">
            <!-- Columna izquierda: campos de reserva -->
            <div class="col-lg-8">
                <div class="beach-panel">
                    <div class="mb-4">
                        <label asp-for="PackageId" class="beach-label">Paquete</label>
                        @if (ViewBag.Packages != null)
                        {
                            <select asp-for="PackageId" id="PackageSelect" class="form-select beach-input">
                                @foreach (var pkg in ViewBag.Packages)
                                {
                                    <option value="@pkg.Id" data-price="@pkg.PricePerNight">@pkg.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select id="PackageSelect" class="form-select beach-input">
                                <option value="1" data-price="900" selected>Todo incluido</option>
                                <option value="2" data-price="550">Alimentación</option>
                                <option value="3" data-price="420">Hospedaje</option>
                            </select>
                            <input type="hidden" asp-for="PackageId" id="HiddenPackageId" value="1" />
                        }
                        <span asp-validation-for="PackageId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CheckInDate" class="beach-label">Fecha de entrada</label>
                            <input asp-for="CheckInDate" type="date" id="CheckInDate" class="form-control beach-input" />
                            <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CheckOutDate" class="beach-label">Fecha de salida</label>
                            <input asp-for="CheckOutDate" type="date" id="CheckOutDate" class="form-control beach-input" />
                            <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="People" class="beach-label">Personas</label>
                            <input asp-for="People" type="number" min="1" id="People" class="form-control beach-input" placeholder="2" />
                            <span asp-validation-for="People" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PaymentMethod" class="beach-label">Forma de pago</label>
                            <select asp-for="PaymentMethod" class="form-select beach-input">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="SINPE Móvil">SINPE Móvil</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna derecha: resumen y botón Confirmar -->
            <div class="col-lg-4">
                <div class="beach-panel">
                    <h2 class="summary-title">Resumen</h2>

                    <div class="summary-row">
                        <span>Noches</span>
                        <span id="summaryNights">@(Model?.AccommodationDays > 0 ? Model.AccommodationDays : 5)</span>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span id="summarySubtotal">$</span>
                    </div>
                    <div class="summary-row">
                        <span>Descuento 10%</span>
                        <span id="summaryDiscount">-$0</span>
                    </div>
                    <div class="summary-row">
                        <span>IVA 13%</span>
                        <span id="summaryIva">$0</span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-total">
                        <span class="summary-total-label">Total USD</span>
                        <span class="summary-total-amount" id="summaryTotal">$0</span>
                    </div>

                    <button type="submit" class="btn-confirm-beach">Confirmar</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const pkgSelect = document.getElementById("PackageSelect");
            const hiddenPkg = document.getElementById("HiddenPackageId");
            const checkInEl = document.getElementById("CheckInDate");
            const checkOutEl = document.getElementById("CheckOutDate");
            const daysInput = document.getElementById("AccommodationDays");
            const discountInput = document.getElementById("Discount");
            const ivaInput = document.getElementById("IVA");

            const nightsEl = document.getElementById("summaryNights");
            const subtotalEl = document.getElementById("summarySubtotal");
            const discountEl = document.getElementById("summaryDiscount");
            const ivaEl = document.getElementById("summaryIva");
            const totalEl = document.getElementById("summaryTotal");

            const formatMoney = (val) =>
                "$" + Number(val || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            function updateSummary() {
                if (hiddenPkg && pkgSelect) {
                    hiddenPkg.value = pkgSelect.value;
                }

                const selectedOption = pkgSelect?.options[pkgSelect.selectedIndex];
                const rate = parseFloat(selectedOption?.dataset?.price || "900");

                let nights = 5;
                if (checkInEl?.value && checkOutEl?.value) {
                    const d1 = new Date(checkInEl.value + "T00:00:00");
                    const d2 = new Date(checkOutEl.value + "T00:00:00");
                    const diffDays = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                    if (diffDays > 0) {
                        nights = diffDays;
                    }
                }

                const subtotal = nights * rate;
                const discountRate = 0.10;
                const ivaRate = 0.13;
                const discountAmount = subtotal * discountRate;
                const taxable = subtotal - discountAmount;
                const ivaAmount = taxable * ivaRate;
                const total = taxable + ivaAmount;

                if (daysInput) daysInput.value = nights;
                if (discountInput) discountInput.value = 10;
                if (ivaInput) ivaInput.value = 13;

                nightsEl.textContent = nights;
                subtotalEl.textContent = formatMoney(subtotal);
                discountEl.textContent = "-" + formatMoney(discountAmount);
                ivaEl.textContent = formatMoney(ivaAmount);
                totalEl.textContent = formatMoney(total);
            }

            [pkgSelect, checkInEl, checkOutEl].forEach(el => {
                el?.addEventListener("change", updateSummary);
            });
        })();
    </script>
}