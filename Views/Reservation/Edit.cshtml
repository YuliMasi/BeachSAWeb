@model BeachSAWeb.Models.Reservation

@{
    ViewData["Title"] = "Modificar reservación";
}

<div class="py-4">
    <h1 class="beach-title h2 mb-4">Modificar reservación R-@Model.Id.ToString("D4")</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm mb-4" role="alert">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Edit" method="post" id="reservationForm">
        <partial name="_ReservationForm" model="Model" />
    </form>

    <a asp-action="Index" class="link-beach d-inline-block mt-3">Volver</a>
</div>
