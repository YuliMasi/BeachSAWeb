@using BeachSAWeb.Services
@model List<BeachSAWeb.Models.Package>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Paquetes";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

@section TopActions {
    <div class="d-flex gap-2">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="pName" value="@ViewData["pName"]" class="form-control beach-pill-input" placeholder="Buscar paquete" />
            <button type="submit" class="btn beach-btn-outline-navy">Buscar</button>
        </form>
        <button type="button" class="btn beach-btn-amber" data-bs-toggle="modal" data-bs-target="#editPackageModal" onclick="clearPackageModal()">
            + Nuevo paquete
        </button>
    </div>
}

<div class="table-responsive">
    <table class="table beach-admin-table">
        <thead>
            <tr>
                <th>Paquete</th>
                <th>Precio por noche</th>
                <th>Prima</th>
                <th>Mensualidades</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No hay paquetes registrados.</td></tr>
            }
            @foreach (var pkg in Model)
            {
                <tr>
                    <td>@PackageInfo.Name(pkg.PackageType)</td>
                    <td>$@pkg.Cost.ToString("N2")</td>
                    <td>@pkg.PercentageTotalAmount%</td>
                    <td>@pkg.RemainingMonthlyInstallments</td>
                    <td>
                        <a href="#" class="beach-link-action" data-bs-toggle="modal" data-bs-target="#editPackageModal"
                           onclick="fillPackageModal(@pkg.Id, '@PackageInfo.Name(pkg.PackageType)', @pkg.Cost.ToString(culture), @pkg.PercentageTotalAmount.ToString(culture), @pkg.RemainingMonthlyInstallments)">Editar</a>
                        <span class="mx-1 text-muted">·</span>
                        <a asp-controller="Package" asp-action="Delete" asp-route-id="@pkg.Id" class="beach-link-action">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_EditPackageModal")

@section Scripts {
    <script>
        function fillPackageModal(id, type, cost, prima, months) {
            document.getElementById("editPackageModalLabel").textContent = "Editar paquete";
            document.getElementById("pkgId").value = id;
            document.getElementById("pkgType").value = type;
            document.getElementById("pkgCost").value = cost;
            document.getElementById("pkgPrima").value = prima;
            document.getElementById("pkgMonths").value = months;
        }

        function clearPackageModal() {
            document.getElementById("editPackageModalLabel").textContent = "Nuevo paquete";
            document.getElementById("pkgId").value = 0;
            document.getElementById("pkgType").value = "Todo incluido";
            setPackageDefaults();
        }

        function setPackageDefaults() {
            const defaults = {
                "Todo incluido": [450, 45, 24],
                "Alimentación": [275, 35, 18],
                "Hospedaje": [210, 15, 12]
            };
            const values = defaults[document.getElementById("pkgType").value];
            document.getElementById("pkgCost").value = values[0];
            document.getElementById("pkgPrima").value = values[1];
            document.getElementById("pkgMonths").value = values[2];
        }
    </script>
}
